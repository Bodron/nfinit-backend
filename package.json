{
  "name": "nfinit-coop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "build:engine": "node --env-file-if-exists=.env scripts/build-engine.js",
    "sync:engine": "node scripts/sync-engine.js",
    "check:atlas": "node --env-file-if-exists=.env scripts/check-atlas.js",
    "test": "node --test test/*.test.js",
    "test:mongo": "node --test test/mongo.integration.js"
  },
  "dependencies": { "mongodb": "^7.8.0", "ws": "^8.22.1" },
  "devDependencies": { "mongodb-memory-server": "^11.0.0" }
}
